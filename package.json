{
  "name": "shotport",
  "version": "0.3.0",
  "description": "Token-cheap screenshot capture for coding agents.",
  "bin": {
    "shotport": "./dist/shotport"
  },
  "module": "index.ts",
  "type": "module",
  "homepage": "https://github.com/edihasaj/shotport#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edihasaj/shotport.git"
  },
  "bugs": {
    "url": "https://github.com/edihasaj/shotport/issues"
  },
  "scripts": {
    "build": "bun build ./index.ts --compile --outfile ./dist/shotport",
    "install:local": "bun run build && install -m 0755 ./dist/shotport /opt/homebrew/bin/shotport",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist/shotport",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "screenshot",
    "cli",
    "agents",
    "ocr",
    "accessibility"
  ],
  "author": "Edi Hasaj <edihasaj@gmail.com> (https://edihasaj.com)",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
